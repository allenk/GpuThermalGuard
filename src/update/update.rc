#include <windows.h>
#include "update/update_resource.h"

// The update script, written out for each update; see apply-update.ps1.
IDR_APPLY_UPDATE RCDATA "apply-update.ps1"

// Update settings. Texts are set at run time in the reader's language.
IDD_UPDATE DIALOGEX 0, 0, 300, 193
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Updates"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Update source", IDC_UPDATE_SOURCE_LABEL, 10, 9, 280, 18
    EDITTEXT IDC_UPDATE_SOURCE, 10, 29, 280, 13, ES_AUTOHSCROLL
    CONTROL "Check automatically", IDC_UPDATE_AUTO_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 48, 280, 10
    LTEXT "Signer pin", IDC_UPDATE_PIN_LABEL, 10, 65, 280, 9
    EDITTEXT IDC_UPDATE_PIN, 10, 76, 280, 13, ES_AUTOHSCROLL
    LTEXT "", IDC_UPDATE_THIS_BUILD, 10, 96, 280, 9
    LTEXT "", IDC_UPDATE_SOURCE_RELEASE, 10, 107, 280, 9
    LTEXT "", IDC_UPDATE_NOTE, 10, 121, 280, 46
    DEFPUSHBUTTON "Save", IDOK, 176, 172, 55, 14
    PUSHBUTTON "Cancel", IDCANCEL, 235, 172, 55, 14
END
