#include <windows.h>
#include "resource.h"
#include "gtg_version.h"
#ifdef GTG_FEATURE_UPDATE
#include "../update/update_resource.h"
#endif

IDI_APP             ICON "../../assets/icons/GpuThermalGuard.ico"
IDI_TRAY_ARMED      ICON "../../assets/icons/tray-armed.ico"
IDI_TRAY_WARNING    ICON "../../assets/icons/tray-warning.ico"
IDI_TRAY_PROTECTED  ICON "../../assets/icons/tray-protected.ico"
IDI_TRAY_FAULT      ICON "../../assets/icons/tray-fault.ico"
IDI_CAMERA          ICON "../../assets/icons/camera.ico"

IDD_MAIN DIALOGEX 0, 0, 430, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "GPU Thermal Guard"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX "GPU Status (Read Only)", IDC_STATUS_GROUP, 8, 7, 198, 163
    LTEXT "GPU", IDC_GPU_LABEL, 18, 22, 28, 10
    LTEXT "Reading...", IDC_GPU_NAME, 57, 20, 139, 19
    LTEXT "VBIOS", IDC_VBIOS_LABEL, 18, 39, 35, 10
    LTEXT "—", IDC_GPU_VBIOS, 57, 39, 139, 10
    LTEXT "Temp", IDC_TEMP_LABEL, 18, 55, 35, 10
    LTEXT "—", IDC_GPU_TEMP, 57, 55, 48, 10
    LTEXT "Power", IDC_POWER_LABEL, 111, 55, 31, 10
    LTEXT "—", IDC_GPU_POWER, 146, 55, 50, 10
    LTEXT "VRAM", IDC_VRAM_LABEL, 18, 70, 35, 10
    LTEXT "—", IDC_GPU_VRAM, 57, 70, 139, 10
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 18, 84, 178, 1
    LTEXT "Power Limit", IDC_LIMIT_LABEL, 18, 90, 38, 10
    LTEXT "—", IDC_GPU_LIMIT, 57, 90, 139, 10
    LTEXT "T.Limits", IDC_THERMAL_LABEL, 18, 105, 38, 10
    LTEXT "—", IDC_GPU_THERMAL, 57, 105, 139, 18
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 18, 126, 178, 1
    CONTROL "", IDC_STATUS_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 18, 130, 30, 24
    LTEXT "Initializing...", IDC_STATUS, 60, 132, 136, 15
    LTEXT "0000-00-00  00:00:00", IDC_WALL_TIME, 88, 147, 108, 8, SS_RIGHT
    LTEXT "Run trips: 0 · since 00-00 00:00", IDC_TRIGGER_COUNT, 18, 158, 143, 8
    PUSHBUTTON "Reset", IDC_RESET_TRIGGER_COUNT, 164, 157, 32, 11, WS_TABSTOP
    GROUPBOX "History (5-minute view / 1 hour)", IDC_HISTORY_GROUP, 212, 7, 210, 163
    CONTROL "", IDC_HISTORY, "Static", SS_NOTIFY, 215, 18, 206, 150
    GROUPBOX "Protection Settings (Apply sets working power limit)", IDC_SETTINGS_GROUP, 8, 172, 414, 45
    LTEXT "Working Limit (W)", IDC_NORMAL_POWER_LABEL, 18, 188, 59, 10
    EDITTEXT IDC_NORMAL_POWER, 78, 185, 42, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Safe Power (W)", IDC_SAFE_POWER_LABEL, 132, 188, 57, 10
    EDITTEXT IDC_SAFE_POWER, 192, 185, 42, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Trigger Temp (°C)", IDC_TRIGGER_TEMP_LABEL, 247, 188, 61, 10
    EDITTEXT IDC_TRIGGER_TEMP, 311, 185, 42, 14, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "Auto Restore", IDC_AUTO_RESTORE,
            "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 359, 186, 59, 12
    LTEXT "Safe power locks after a trip; choose manual or automatic restore after cooling.", IDC_SETTINGS_NOTE, 18, 204, 395, 10
    // The layout:
    // the record switches on one row, the three choices as labelled combos
    // on the next, the actions right-aligned at the bottom.
    // The row says what its switches are for.
    LTEXT "Display:", IDC_DISPLAY_LABEL, 10, 222, 40, 12, SS_CENTERIMAGE
    CONTROL "OSD", IDC_OSD_ENABLED,
            "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 53, 222, 44, 12
    CONTROL "RAM", IDC_SHOW_RAM,
            "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 101, 222, 44, 12
    CONTROL "NET", IDC_SHOW_NET,
            "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 149, 222, 44, 12
    CONTROL "FPS", IDC_SHOW_FPS,
            "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 197, 222, 44, 12
    CONTROL "Overlay", IDC_OVERLAY_ENABLED,
            "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 245, 222, 70, 12
    CONTROL "Top app", IDC_SHOW_TOP_APP,
            "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 319, 222, 62, 12
    // Paired GTGs: on and off, pairing and the list live in their own dialog.
    PUSHBUTTON "Hosts...", IDC_HOSTS, 383, 221, 39, 14, WS_TABSTOP
    LTEXT "Theme", IDC_THEME_LABEL, 10, 237, 128, 9
    COMBOBOX IDC_THEME, 10, 247, 128, 80,
             CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Language", IDC_LANGUAGE_LABEL, 151, 237, 128, 9
    COMBOBOX IDC_LANGUAGE, 151, 247, 128, 80,
             CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "OSD size", IDC_OSD_SCALE_LABEL, 292, 237, 80, 9
    COMBOBOX IDC_OSD_SCALE, 292, 247, 80, 120,
             CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    // The expanded OSD as cards instead of lanes; off unless chosen.
    CONTROL "Cards", IDC_OSD_CARD,
            "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 376, 248, 46, 12
    // Three switches stacked in the bottom-left corner, beside the actions
    // (owner, 2026-10-08: "checkbox 可能只能塞 左下").
    CONTROL "Hide desktop OSD in game", IDC_OVERLAY_HIDES_OSD,
            "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 263, 150, 10
    CONTROL "Auto SDR (skip prompt)", IDC_OVERLAY_AUTO_SDR,
            "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 274, 150, 10
    CONTROL "[X] Close to Tray", IDC_CLOSE_TO_TRAY,
            "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 285, 150, 10
    PUSHBUTTON "Overlay Hotkey", IDC_OVERLAY_HOTKEY, 166, 266, 71, 26, WS_TABSTOP
    PUSHBUTTON "Capture Snapshot", IDC_CAPTURE_SNAPSHOT, 242, 266, 24, 26, BS_ICON | WS_TABSTOP
    // A push button, so it is drawn like its neighbours. MainDialog makes it
    // owner-drawn only while settings are unsaved, for the orange.
    PUSHBUTTON "Save && Apply", IDC_SAVE_SETTINGS, 271, 266, 65, 26, WS_TABSTOP
    DEFPUSHBUTTON "Hide to Tray", IDC_HIDE_TO_TRAY, 341, 266, 81, 26
END

// The overlay hotkey, after PowerToys' shortcut dialog: keys are read by a
// hook while the dialog is in front and shown as owner-drawn keycaps.
// Stored only until the in-game overlay lands; the note says so.
IDD_OVERLAY_HOTKEY DIALOGEX 0, 0, 240, 112
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Overlay Hotkey"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Press the key combination that shows the in-game overlay.", IDC_HOTKEY_PROMPT, 10, 9, 220, 10
    CONTROL "", IDC_HOTKEY_EDIT, "Static", SS_OWNERDRAW, 10, 24, 220, 18
    LTEXT "", IDC_HOTKEY_NOTE, 10, 50, 220, 30
    PUSHBUTTON "Default", IDC_HOTKEY_DEFAULT, 10, 88, 60, 16, WS_TABSTOP
    DEFPUSHBUTTON "Save", IDOK, 116, 88, 55, 16, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 175, 88, 55, 16, WS_TABSTOP
END

// Hosts: paired GTGs. The QR code is owner-drawn, whole pixels per module.
#ifdef GTG_FEATURE_UPDATE
IDD_HOSTS DIALOGEX 0, 0, 330, 346
#else
IDD_HOSTS DIALOGEX 0, 0, 330, 286
#endif
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Hosts"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL "Hosts", IDC_HOSTS_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 8, 310, 10
    LTEXT "This machine", IDC_HOSTS_NAME_LABEL, 10, 26, 60, 9
    EDITTEXT IDC_HOSTS_NAME, 72, 24, 160, 13, ES_AUTOHSCROLL
    LTEXT "Port", IDC_HOSTS_PORT_LABEL, 244, 26, 30, 9
    EDITTEXT IDC_HOSTS_PORT, 278, 24, 42, 13, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Paired hosts", IDC_HOSTS_LIST_LABEL, 10, 44, 310, 9
    CONTROL "", IDC_HOSTS_LIST, "SysListView32",
            LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER |
            WS_TABSTOP, 10, 55, 268, 78
    PUSHBUTTON "Up", IDC_HOSTS_UP, 283, 55, 37, 14, WS_TABSTOP
    PUSHBUTTON "Down", IDC_HOSTS_DOWN, 283, 72, 37, 14, WS_TABSTOP
    PUSHBUTTON "Remove", IDC_HOSTS_REMOVE, 283, 119, 37, 14, WS_TABSTOP
#ifdef GTG_FEATURE_UPDATE
    CONTROL "Let other hosts update this machine", IDC_HOSTS_UPDATE_ALLOW, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 10, 139, 310, 10
    LTEXT "", IDC_HOSTS_UPDATE_SOURCE, 10, 155, 248, 9
    PUSHBUTTON "Check again", IDC_HOSTS_UPDATE_CHECK, 264, 152, 58, 14, WS_TABSTOP
    PUSHBUTTON "Update", IDC_HOSTS_UPDATE_ONE, 10, 169, 62, 14, WS_TABSTOP
    PUSHBUTTON "Force update", IDC_HOSTS_UPDATE_FORCE, 76, 169, 70, 14, WS_TABSTOP
    PUSHBUTTON "Update all", IDC_HOSTS_UPDATE_ALL, 150, 169, 62, 14, WS_TABSTOP
    PUSHBUTTON "Stop", IDC_HOSTS_UPDATE_STOP, 216, 169, 44, 14, WS_TABSTOP
    LTEXT "", IDC_HOSTS_UPDATE_STATUS, 10, 186, 312, 9
    GROUPBOX "Pair with another GTG", IDC_HOSTS_PAIR_GROUP, 8, 199, 314, 96
    PUSHBUTTON "Create code", IDC_HOSTS_CREATE, 16, 211, 70, 14, WS_TABSTOP
    LTEXT "", IDC_HOSTS_CODE_STATUS, 90, 210, 146, 17
    EDITTEXT IDC_HOSTS_CODE, 16, 229, 182, 13, ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON "Copy", IDC_HOSTS_COPY, 202, 229, 34, 13, WS_TABSTOP
    LTEXT "Paste a code", IDC_HOSTS_JOIN_LABEL, 16, 249, 220, 9
    EDITTEXT IDC_HOSTS_JOIN_CODE, 16, 260, 182, 13, ES_AUTOHSCROLL
    PUSHBUTTON "Join", IDC_HOSTS_JOIN, 202, 260, 34, 13, WS_TABSTOP
    LTEXT "", IDC_HOSTS_JOIN_STATUS, 16, 276, 220, 17
    CONTROL "", IDC_HOSTS_QR, "Static", SS_OWNERDRAW, 242, 211, 76, 76
    LTEXT "", IDC_HOSTS_NOTE, 10, 299, 248, 41
    DEFPUSHBUTTON "Close", IDOK, 264, 324, 58, 14
#else
    GROUPBOX "Pair with another GTG", IDC_HOSTS_PAIR_GROUP, 8, 139, 314, 96
    PUSHBUTTON "Create code", IDC_HOSTS_CREATE, 16, 151, 70, 14, WS_TABSTOP
    LTEXT "", IDC_HOSTS_CODE_STATUS, 90, 150, 146, 17
    EDITTEXT IDC_HOSTS_CODE, 16, 169, 182, 13, ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON "Copy", IDC_HOSTS_COPY, 202, 169, 34, 13, WS_TABSTOP
    LTEXT "Paste a code", IDC_HOSTS_JOIN_LABEL, 16, 189, 220, 9
    EDITTEXT IDC_HOSTS_JOIN_CODE, 16, 200, 182, 13, ES_AUTOHSCROLL
    PUSHBUTTON "Join", IDC_HOSTS_JOIN, 202, 200, 34, 13, WS_TABSTOP
    LTEXT "", IDC_HOSTS_JOIN_STATUS, 16, 216, 220, 17
    CONTROL "", IDC_HOSTS_QR, "Static", SS_OWNERDRAW, 242, 151, 76, 76
    LTEXT "", IDC_HOSTS_NOTE, 10, 239, 248, 41
    DEFPUSHBUTTON "Close", IDOK, 264, 264, 58, 14
#endif
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION GTG_VERSION_COMMA
 PRODUCTVERSION GTG_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo" BEGIN BLOCK "040904b0" BEGIN
  VALUE "CompanyName", "AllenK (kwyshell)\0"
  VALUE "Author", "AllenK (kwyshell)\0"
  VALUE "Comments", "GitHub: https://github.com/allenk | Medium: https://medium.com/@allenkuo\0"
  VALUE "FileDescription", "GPU Thermal Guard\0"
  VALUE "FileVersion", GTG_VERSION_STR
  VALUE "InternalName", "GpuThermalGuard.exe\0"
  VALUE "LegalCopyright", "Copyright (c) 2026 AllenK (kwyshell)\0"
  VALUE "OriginalFilename", "GpuThermalGuard.exe\0"
  VALUE "ProductName", "GPU Thermal Guard\0"
  VALUE "ProductVersion", GTG_VERSION_STR
 END END
 BLOCK "VarFileInfo" BEGIN VALUE "Translation", 0x0409, 1200 END
END
